# Secrets: must never enter image layers (docker history would expose them).
# They are bind-mounted at runtime instead.
**/.hibs_api_key
**/.opensquat_api_key

# Scan history and runtime output: lives in the bind mount, not the image.
**/output/
**/run_logs/
**/run_scanners.out

# Local dev noise
.venv/
__pycache__/
*.pyc
.git/
